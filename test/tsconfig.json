{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    // `bun`, not `bun-types`: scripts/tsconfig.json resolves it this way and
    // runs in CI today. The previous typeRoots override excluded
    // node_modules, so the type library was never found and tsc stopped
    // before reading a single test file.
    "types": ["bun"]
  },
  "include": ["./**/*", "../src/**/*"],
  "exclude": [
    "../node_modules",
    // Imports the built package, so it only resolves after a build.
    // scripts/tsconfig.json type-checks it in CI once dist/ exists.
    "./browser/fixture.ts",
    // Each compiles on its own, with its framework's JSX settings, in
    // test/build/jsx-types.test.ts: an augmentation applies to a whole program.
    "./types/jsx"
  ]
}
